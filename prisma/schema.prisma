generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bots                      Bot[]
  submissions               Submission[]
  hostedRooms               Room[]             @relation("RoomHost")
  roomSeats                 RoomPlayer[]
  sentFriendRequests        FriendRequest[]    @relation("FriendRequestSender")
  receivedFriendRequests    FriendRequest[]    @relation("FriendRequestReceiver")
  presenceSessions          UserPresence[]
  sentSocialInvitations     SocialInvitation[] @relation("SocialInvitationSender")
  receivedSocialInvitations SocialInvitation[] @relation("SocialInvitationReceiver")

  hostedTournaments Tournament[]     @relation("TournamentHost")
  tournamentEntries TournamentEntry[]
}

model Bot {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String?  @db.Text
  sourceCode  String   @db.LongText
  language    String   @default("javascript") @db.VarChar(30)
  protocolVersion Int   @default(1)
  isActive    Boolean  @default(true)
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  participants   MatchParticipant[]
  submissions    Submission[]
  roomSelections RoomPlayer[]
  tournamentEntries TournamentEntry[]
}

model Match {
  id        Int       @id @default(autoincrement())
  status    String    @default("pending") @db.VarChar(30)
  winnerId  Int?
  result    Json?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  roomId    Int?      @unique

  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  participants MatchParticipant[]
}

model Room {
  id               Int       @id @default(autoincrement())
  name             String    @unique @db.VarChar(80)
  password         String?   @db.VarChar(72)
  passwordHash     String    @db.VarChar(255)
  visibility       String    @default("public") @db.VarChar(20)
  status           String    @default("waiting") @db.VarChar(20)
  hostUserId       Int
  pausedByUserId   Int?
  pauseStartedAt   DateTime?
  rematchStatus    String    @default("none") @db.VarChar(20)
  rematchExpiresAt DateTime?
  revision         Int       @default(0)
  createdAt        DateTime  @default(now())

  hostUser          User               @relation("RoomHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  players           RoomPlayer[]
  presences         RoomPresence[]
  match             Match?
  socialInvitations SocialInvitation[]

  @@index([visibility, status, createdAt])
  @@index([hostUserId, status])
}

model RoomPresence {
  id         Int      @id @default(autoincrement())
  roomId     Int
  sessionId  String   @db.Char(36)
  userId     Int?
  lastSeenAt DateTime @default(now()) @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, sessionId])
  @@index([roomId, lastSeenAt])
  @@index([lastSeenAt])
}

model RoomPlayer {
  id              Int       @id @default(autoincrement())
  roomId          Int
  userId          Int
  slot            Int
  botId           Int?
  isReady         Boolean   @default(false)
  rematchAccepted Boolean   @default(false)
  pauseUsedMs     Int       @default(0)
  leftAt          DateTime?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  Bot? @relation(fields: [botId], references: [id], onDelete: SetNull)

  @@unique([roomId, userId])
  @@unique([roomId, slot])
  @@index([userId, leftAt])
}

model MatchParticipant {
  id       Int     @id @default(autoincrement())
  matchId  Int
  botId    Int
  score    Float   @default(0)
  isWinner Boolean @default(false)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  bot   Bot   @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([matchId, botId])
}

model Submission {
  id         Int      @id @default(autoincrement())
  sourceCode String   @db.LongText
  language   String   @default("javascript") @db.VarChar(30)
  protocolVersion Int   @default(1)
  status     String   @default("pending") @db.VarChar(30)
  result     Json?
  createdAt  DateTime @default(now())

  userId Int
  botId  Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  Bot? @relation(fields: [botId], references: [id], onDelete: SetNull)
}

model FriendRequest {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     String   @default("pending") @db.VarChar(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status, createdAt])
  @@index([senderId, status, createdAt])
}

model UserPresence {
  id         Int      @id @default(autoincrement())
  userId     Int
  sessionId  String   @db.Char(36)
  lastSeenAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([lastSeenAt])
}

model SocialInvitation {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  roomId     Int?
  kind       String   @db.VarChar(20)
  status     String   @default("pending") @db.VarChar(20)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User  @relation("SocialInvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User  @relation("SocialInvitationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  room     Room? @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([receiverId, status, expiresAt])
  @@index([senderId, status, expiresAt])
  @@index([roomId, kind, status])
}

model Tournament {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(120)
  description String?   @db.Text
  status      String    @default("draft") @db.VarChar(20)
  format      String    @default("round_robin") @db.VarChar(30)
  lockedAt    DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  hostUserId Int
  hostUser   User @relation("TournamentHost", fields: [hostUserId], references: [id], onDelete: Cascade)

  entries TournamentEntry[]
  rounds  TournamentRound[]
  matches TournamentMatch[]

  @@index([status, createdAt])
  @@index([hostUserId, status])
}

model TournamentEntry {
  id                     Int      @id @default(autoincrement())
  seed                   Int
  snapshotSourceCode     String   @db.LongText
  snapshotLanguage       String   @default("javascript") @db.VarChar(30)
  snapshotProtocolVersion Int     @default(2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tournamentId Int
  userId       Int
  botId        Int

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot        Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)

  matchAsA TournamentMatch[] @relation("MatchEntryA")
  matchAsB TournamentMatch[] @relation("MatchEntryB")
  gamesAsFirst  TournamentGame[] @relation("GameFirstEntry")
  gamesAsSecond TournamentGame[] @relation("GameSecondEntry")
  wonGames      TournamentGame[] @relation("GameWinner")

  @@unique([tournamentId, userId])
  @@unique([tournamentId, botId])
  @@index([tournamentId, seed])
}

model TournamentRound {
  id           Int      @id @default(autoincrement())
  roundNumber  Int
  status       String   @default("pending") @db.VarChar(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  matches TournamentMatch[]

  @@unique([tournamentId, roundNumber])
}

model TournamentMatch {
  id        Int      @id @default(autoincrement())
  status    String   @default("pending") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tournamentId Int
  roundId      Int
  entryAId     Int
  entryBId     Int

  tournament Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round       TournamentRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  entryA      TournamentEntry @relation("MatchEntryA", fields: [entryAId], references: [id], onDelete: Cascade)
  entryB      TournamentEntry @relation("MatchEntryB", fields: [entryBId], references: [id], onDelete: Cascade)

  games TournamentGame[]

  @@unique([tournamentId, entryAId, entryBId])
  @@index([roundId, status])
}

model TournamentGame {
  id             Int       @id @default(autoincrement())
  legNumber      Int
  status         String    @default("pending") @db.VarChar(20)
  winnerEntryId  Int?
  isDraw         Boolean   @default(false)
  winReason      String?   @db.VarChar(60)
  turns          Int?
  attempts       Int       @default(0)
  errorCode      String?   @db.VarChar(80)
  errorMessage   String?   @db.VarChar(500)
  result         Json?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  matchId       Int
  firstEntryId  Int
  secondEntryId Int

  match       TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  firstEntry  TournamentEntry @relation("GameFirstEntry", fields: [firstEntryId], references: [id], onDelete: Cascade)
  secondEntry TournamentEntry @relation("GameSecondEntry", fields: [secondEntryId], references: [id], onDelete: Cascade)
  winnerEntry TournamentEntry? @relation("GameWinner", fields: [winnerEntryId], references: [id], onDelete: SetNull)

  @@unique([matchId, legNumber])
  @@index([status, createdAt])
}
